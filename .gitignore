# ── Secretos ──
# Nunca subas llaves de API, contraseñas ni cadenas de conexión.
.env
.env.*
# La plantilla sí se sube: no tiene valores, sólo dice qué variables hacen falta.
!.env.ejemplo
*.key
*.pem
secrets.json

# ── Dependencias (cuando migremos a Next.js) ──
node_modules/
.next/
dist/
build/

# ── Sistema operativo ──
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── Editores ──
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# ── Temporales ──
*.log
*.tmp
~$*
dist/

# Generado por tools/empacar-js.js en cada compilacion. No se versiona: son
# los mismos archivos de assets/js/ pegados, y cambiaria en cada commit.
assets/js/sitio.js

# Salida de la prueba visual cuando una captura cambia. Las referencias SI se
# versionan; estas son la comparacion de un momento.
tests/capturas/*.nueva.png
