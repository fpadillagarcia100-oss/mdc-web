# Copia este archivo como `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se sube. Éste sí, porque no tiene secretos.

# La dirección pública del servidor (servidor/Mdc.Api), el que habla con el
# SQL Server de la oficina. La publica Cloudflare Tunnel.
#
# No es un secreto: viaja a cada visitante dentro de catalogo-datos.js,
# porque su navegador la necesita para mandar una cotización. Sin sesión, la
# API sólo recibe cotizaciones, preguntas y vistas.
#
# Para desarrollo con la API en tu máquina: API_URL=http://localhost:5080
API_URL=https://api.mdcmaquinaria.com

# Los secretos del servidor (clave de los tokens, secreto de los avisos,
# hook de despliegue) NO van aquí: los pone servidor/instalar.ps1 en la
# configuración del servicio de Windows.
